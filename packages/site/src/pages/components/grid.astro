---
import { Anchor, Code, Grid, GridItem, Heading, Stack, Text } from "@ps1ui/core";
import ComponentPage from "../../layouts/ComponentPage.astro";
import Demo from "../../components/Demo.astro";
import DemoBox from "../../components/DemoBox.astro";
import { href } from "../../lib/url";

const columns = `<Grid columns={3} gap="md">
  <div>01</div>
  <div>02</div>
  <div>03</div>
  <div>04</div>
  <div>05</div>
  <div>06</div>
</Grid>`;

const responsive = `<Grid columns={{ base: 1, sm: 2, md: 3 }} gap="md">
  <div>01</div>
  <div>02</div>
  <div>03</div>
  <div>04</div>
  <div>05</div>
  <div>06</div>
</Grid>`;

const gridItemSpan = `<Grid columns={4} gap="md">
  <GridItem colSpan={2}>hero</GridItem>
  <GridItem>02</GridItem>
  <GridItem>03</GridItem>
  <GridItem>04</GridItem>
  <GridItem>05</GridItem>
  <GridItem>06</GridItem>
</Grid>`;

const gridItemResponsive = `<Grid columns={4} gap="md">
  <GridItem colSpan={{ base: 4, md: 2, lg: 4 }}>hero</GridItem>
  <GridItem>02</GridItem>
  <GridItem>03</GridItem>
  <GridItem>04</GridItem>
  <GridItem>05</GridItem>
</Grid>`;

const asList = `{/* A card grid is a list — say so in the markup rather than
    with role="list" on a <div>. Pair the tags: <ul> takes <li> children. */}
<Grid as="ul" columns={3} gap="md" aria-label="cards">
  <GridItem as="li" colSpan={2}>hero</GridItem>
  <GridItem as="li">02</GridItem>
  <GridItem as="li">03</GridItem>
</Grid>`;

const queryContainer = `{/* The inner Grid — and any GridItem colSpan inside it —
    now measures the 320px outer Grid instead of the page. */}
<Grid queryContainer columns={1} style={{ width: 320 }}>
  <Grid columns={{ base: 1, md: 3 }} gap="md">
    <div>01</div>
    <div>02</div>
    <div>03</div>
  </Grid>
</Grid>`;
---

<ComponentPage slug="grid">
  <Demo title="Columns" code={columns}>
    <Grid columns={3} gap="md">
      <DemoBox>01</DemoBox>
      <DemoBox>02</DemoBox>
      <DemoBox>03</DemoBox>
      <DemoBox>04</DemoBox>
      <DemoBox>05</DemoBox>
      <DemoBox>06</DemoBox>
    </Grid>
  </Demo>

  <Demo title="Responsive columns" code={responsive}>
    <Grid columns={{ base: 1, sm: 2, md: 3 }} gap="md">
      <DemoBox>01</DemoBox>
      <DemoBox>02</DemoBox>
      <DemoBox>03</DemoBox>
      <DemoBox>04</DemoBox>
      <DemoBox>05</DemoBox>
      <DemoBox>06</DemoBox>
    </Grid>
  </Demo>

  <Demo title="Column span with GridItem" code={gridItemSpan}>
    <Grid columns={4} gap="md">
      <GridItem colSpan={2}><DemoBox>hero</DemoBox></GridItem>
      <GridItem><DemoBox>02</DemoBox></GridItem>
      <GridItem><DemoBox>03</DemoBox></GridItem>
      <GridItem><DemoBox>04</DemoBox></GridItem>
      <GridItem><DemoBox>05</DemoBox></GridItem>
      <GridItem><DemoBox>06</DemoBox></GridItem>
    </Grid>
  </Demo>

  <Demo title="Responsive column span" code={gridItemResponsive}>
    <Grid columns={4} gap="md">
      <GridItem colSpan={{ base: 4, md: 2, lg: 4 }}><DemoBox>hero</DemoBox></GridItem>
      <GridItem><DemoBox>02</DemoBox></GridItem>
      <GridItem><DemoBox>03</DemoBox></GridItem>
      <GridItem><DemoBox>04</DemoBox></GridItem>
      <GridItem><DemoBox>05</DemoBox></GridItem>
    </Grid>
  </Demo>

  <Stack direction="column" gap="md">
    <Heading level={2} size="lg">Semantic element</Heading>
    <Text>
      Pass <Code>as</Code> to render a tag other than the default <Code
        >&lt;div&gt;</Code
      >. A card grid is usually a list, so <Code>{'<Grid as="ul">'}</Code> beats layering
      <Code>role="list"</Code> onto a <Code>&lt;div&gt;</Code> — and because a <Code
        >&lt;ul&gt;</Code
      > may only contain <Code>&lt;li&gt;</Code>, <Code>GridItem</Code> carries the
      same prop. Change the two together.
    </Text>
    <Text>
      Everything else is unchanged: columns, gap, <Code>colSpan</Code> and <Code
        >queryContainer</Code
      > behave identically on any tag, the rendered element's own attributes become
      available, and <Code>as</Code> also accepts a component rather than a tag name.
    </Text>
  </Stack>

  <Demo title="As a list" code={asList}>
    <Grid as="ul" columns={3} gap="md" aria-label="cards">
      <GridItem as="li" colSpan={2}><DemoBox>hero</DemoBox></GridItem>
      <GridItem as="li"><DemoBox>02</DemoBox></GridItem>
      <GridItem as="li"><DemoBox>03</DemoBox></GridItem>
    </Grid>
  </Demo>

  <Stack direction="column" gap="md">
    <Heading level={2} size="lg">Query container</Heading>
    <Text>
      Responsive props resolve against the nearest ancestor that is a
      container-query context — normally the <Anchor href={href("components/ps1root/")}
        >PS1Root</Anchor
      > wrapping your app. Pass <Code>queryContainer</Code> to make a
      <Code>Grid</Code> that context instead. This is also what makes a child
      <Code>GridItem</Code>'s responsive <Code>colSpan</Code> track the Grid's own
      width rather than the page's.
    </Text>
    <Text>
      It is opt-in because <Code>container-type: inline-size</Code> erases the element's
      intrinsic width: an opted-in <Code>Grid</Code> collapses to zero inside any
      shrink-to-fit parent (a row <Code>Stack</Code>, an auto grid track, a float).
      Give it a definite inline size whenever you turn it on.
    </Text>
  </Stack>

  <Demo title="Query container" code={queryContainer}>
    <Grid queryContainer columns={1} style={{ width: 320, maxWidth: "100%" }}>
      <Grid columns={{ base: 1, md: 3 }} gap="md">
        <DemoBox>01</DemoBox>
        <DemoBox>02</DemoBox>
        <DemoBox>03</DemoBox>
      </Grid>
    </Grid>
  </Demo>
</ComponentPage>
