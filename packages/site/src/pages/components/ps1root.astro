---
import { Button, Card, Code, CodeBlock, Grid, Heading, PS1Root, Stack, Text } from "@ps1ui/core";
import ComponentPage from "../../layouts/ComponentPage.astro";
import Demo from "../../components/Demo.astro";

const usage = `import { PS1Root } from "@ps1ui/core";

export function App() {
  return (
    <PS1Root>
      {/* your app */}
    </PS1Root>
  );
}`;

// PS1Root is a container-query context unconditionally, which implies
// `contain: inline-size` — inside a row Stack (a flex main axis) that
// collapses its intrinsic width to 0 and the two Cards below would overlap.
// A Grid gives each PS1Root a definite track width instead, which
// containment can't erase — see PS1Root.tsx's header comment and Stack.css's
// `--query-container` note in core.
const theme = `<Grid columns={{ base: 1, md: 2 }} gap="lg">
  <PS1Root theme="light" style={{ padding: 16 }}>
    <Card>
      <Text>Light</Text>
      <Button variant="primary">Click me</Button>
    </Card>
  </PS1Root>
  <PS1Root theme="dark" style={{ padding: 16 }}>
    <Card>
      <Text>Dark</Text>
      <Button variant="primary">Click me</Button>
    </Card>
  </PS1Root>
</Grid>`;
---

<ComponentPage slug="ps1root">
  <Stack direction="column" gap="md">
    <Heading level={2} size="lg">Usage</Heading>
    <Text>
      Wrap your app in <Code>PS1Root</Code> once, at the top of the tree. Responsive props on
      descendant components resolve against it — without a <Code>PS1Root</Code> ancestor they
      silently fall back to their <Code>base</Code> values.
    </Text>
    <CodeBlock language="tsx" code={usage} />
    <Text>
      <Code>PS1Root</Code> is the only component that is a container-query context
      unconditionally. <Code>Container</Code>, <Code>Grid</Code> and <Code>Stack</Code> can each
      become one too, but only when you pass them <Code>queryContainer</Code> — establishing a
      context costs an element its intrinsic width, so it is never applied for you.
    </Text>
  </Stack>

  <Text variant="muted">
    A <Code>PS1Root</Code> given a <Code>theme</Code> paints its own canvas and text color, so a
    themed subtree like either one below is self-contained. An untheme'd <Code>PS1Root</Code>
    paints nothing.
  </Text>
  <Demo title="Theme" code={theme}>
    <Grid columns={{ base: 1, md: 2 }} gap="lg">
      <PS1Root theme="light" style={{ padding: 16 }}>
        <Card>
          <Text>Light</Text>
          <Button variant="primary">Click me</Button>
        </Card>
      </PS1Root>
      <PS1Root theme="dark" style={{ padding: 16 }}>
        <Card>
          <Text>Dark</Text>
          <Button variant="primary">Click me</Button>
        </Card>
      </PS1Root>
    </Grid>
  </Demo>
</ComponentPage>
