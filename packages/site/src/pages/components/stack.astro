---
import { Anchor, Code, Heading, Stack, Text } from "@ps1ui/core";
import ComponentPage from "../../layouts/ComponentPage.astro";
import Demo from "../../components/Demo.astro";
import DemoBox from "../../components/DemoBox.astro";
import { href } from "../../lib/url";

const row = `<Stack direction="row" gap="md">
  <div>01</div>
  <div>02</div>
  <div>03</div>
</Stack>`;

const column = `<Stack direction="column" gap="sm">
  <div>01</div>
  <div>02</div>
  <div>03</div>
</Stack>`;

const responsive = `<Stack direction={{ base: "column", md: "row" }} gap="md">
  <div>01</div>
  <div>02</div>
  <div>03</div>
</Stack>`;

// Labelled "Example", not "primary": the demo renders a real <nav> landmark on
// this page, alongside the site header's and the sidebar's. Every <nav> in a
// document needs a distinct label, and a decorative one must not claim to be
// the page's primary navigation.
const asNav = `{/* The layout box IS the landmark — no wrapper, no hand-rolled flex CSS. */}
<Stack as="nav" aria-label="Example" direction="row" gap="md">
  <Anchor href="/docs">docs</Anchor>
  <Anchor href="/blog">blog</Anchor>
  <Anchor href="/about">about</Anchor>
</Stack>`;

const asList = `<Stack as="ul" gap="sm">
  <li>01</li>
  <li>02</li>
  <li>03</li>
</Stack>`;

const queryContainer = `{/* The inner Stack now measures the 320px outer Stack
    instead of the page, so it stays on its \`base\` value. */}
<Stack queryContainer style={{ width: 320 }}>
  <Stack direction={{ base: "column", md: "row" }} gap="md">
    <div>01</div>
    <div>02</div>
    <div>03</div>
  </Stack>
</Stack>`;
---

<ComponentPage slug="stack">
  <Demo title="Row" code={row}>
    <Stack direction="row" gap="md">
      <DemoBox>01</DemoBox>
      <DemoBox>02</DemoBox>
      <DemoBox>03</DemoBox>
    </Stack>
  </Demo>

  <Demo title="Column" code={column}>
    <Stack direction="column" gap="sm">
      <DemoBox>01</DemoBox>
      <DemoBox>02</DemoBox>
      <DemoBox>03</DemoBox>
    </Stack>
  </Demo>

  <Demo title="Responsive direction" code={responsive}>
    <Stack direction={{ base: "column", md: "row" }} gap="md">
      <DemoBox>01</DemoBox>
      <DemoBox>02</DemoBox>
      <DemoBox>03</DemoBox>
    </Stack>
  </Demo>

  <Stack direction="column" gap="md">
    <Heading level={2} size="lg">Semantic element</Heading>
    <Text>
      A layout box is very often the semantic element too — a <Code>&lt;nav&gt;</Code
      > of links, the page <Code>&lt;main&gt;</Code>, a <Code>&lt;ul&gt;</Code> of
      rows. Pass <Code>as</Code> to render that tag instead of the default <Code
        >&lt;div&gt;</Code
      >; every layout prop, the styling and <Code>queryContainer</Code> behave exactly
      as they do on a <Code>&lt;div&gt;</Code>, and the rendered element's own attributes
      (plus a correctly typed <Code>ref</Code>) become available on <Code>Stack</Code
      >.
    </Text>
    <Text>
      <Code>as</Code> also takes a component, not just a tag name — <Code
        >{'as={NextLink}'}</Code
      > forwards the merged class and style to it.
    </Text>
  </Stack>

  <Demo title="As a navigation landmark" code={asNav}>
    <Stack as="nav" aria-label="Example" direction="row" gap="md">
      <Anchor href={href("components/")}>docs</Anchor>
      <Anchor href={href("components/grid/")}>grid</Anchor>
      <Anchor href={href("components/container/")}>container</Anchor>
    </Stack>
  </Demo>

  <Demo title="As a list" code={asList}>
    <Stack as="ul" gap="sm">
      <li><DemoBox>01</DemoBox></li>
      <li><DemoBox>02</DemoBox></li>
      <li><DemoBox>03</DemoBox></li>
    </Stack>
  </Demo>

  <Stack direction="column" gap="md">
    <Heading level={2} size="lg">Query container</Heading>
    <Text>
      Responsive props resolve against the nearest ancestor that is a
      container-query context — normally the <Anchor href={href("components/ps1root/")}
        >PS1Root</Anchor
      > wrapping your app. Pass <Code>queryContainer</Code> to make a
      <Code>Stack</Code> that context instead, so its descendants respond to that
      Stack's own width rather than the page's. Useful for sidebars, split panes
      and card slots.
    </Text>
    <Text>
      It is opt-in because <Code>container-type: inline-size</Code> erases the element's
      intrinsic width: an opted-in <Code>Stack</Code> collapses to zero inside any
      shrink-to-fit parent (a row <Code>Stack</Code>, an auto grid track, a float).
      Give it a definite inline size — an explicit width, <Code>flex: 1</Code>, or a
      block-level parent — whenever you turn it on.
    </Text>
  </Stack>

  <Demo title="Query container" code={queryContainer}>
    <Stack queryContainer style={{ width: 320, maxWidth: "100%" }}>
      <Stack direction={{ base: "column", md: "row" }} gap="md">
        <DemoBox>01</DemoBox>
        <DemoBox>02</DemoBox>
        <DemoBox>03</DemoBox>
      </Stack>
    </Stack>
  </Demo>
</ComponentPage>
