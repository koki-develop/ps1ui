---
import ComponentPage from "../../layouts/ComponentPage.astro";
import Demo from "../../components/Demo.astro";
import { TabsBasicDemo, TabsDisabledDemo, TabsVerticalDemo } from "../../demos/TabsDemos";

// Tabs' selected state lives in React Context, and Astro renders every
// framework component in a .astro file as its own island — the group's
// context would never cross the island boundary if <Tabs> / <TabList> /
// <Tab> / <TabPanel> were composed from `.astro` template syntax, leaving
// switching tabs inert. Each demo is a self-contained React component (see
// src/demos/TabsDemos.tsx) rendered with `client:load` so tab switching
// actually works. This is the "proven needed" exception to
// packages/site/CLAUDE.md § "No `client:*` unless proven needed"; a static
// Tabs demo would be inert.
---

<ComponentPage slug="tabs">
  <Demo
    title="Basic"
    code={`<Tabs defaultValue="overview">
  <TabList aria-label="doc sections">
    <Tab value="overview">Overview</Tab>
    <Tab value="install">Install</Tab>
    <Tab value="api">API</Tab>
  </TabList>
  <TabPanel value="overview">
    A monospace UI toolkit for building terminal-inspired dashboards.
  </TabPanel>
  <TabPanel value="install">Install with pnpm add @ps1ui/core.</TabPanel>
  <TabPanel value="api">See the Props table on each component's page.</TabPanel>
</Tabs>`}
  >
    <TabsBasicDemo client:load />
  </Demo>

  <Demo
    title="With a disabled tab"
    code={`<Tabs defaultValue="overview">
  <TabList aria-label="doc sections">
    <Tab value="overview">Overview</Tab>
    <Tab value="install" disabled>Install</Tab>
    <Tab value="api">API</Tab>
  </TabList>
  <TabPanel value="overview">Overview content.</TabPanel>
  <TabPanel value="install">Install content.</TabPanel>
  <TabPanel value="api">API content.</TabPanel>
</Tabs>`}
  >
    <TabsDisabledDemo client:load />
  </Demo>

  <Demo
    title="Vertical orientation"
    code={`<Tabs defaultValue="overview" orientation="vertical">
  <TabList aria-label="doc sections">
    <Tab value="overview">Overview</Tab>
    <Tab value="install">Install</Tab>
    <Tab value="api">API</Tab>
  </TabList>
  <TabPanel value="overview">Overview content.</TabPanel>
  <TabPanel value="install">Install content.</TabPanel>
  <TabPanel value="api">API content.</TabPanel>
</Tabs>`}
  >
    <TabsVerticalDemo client:load />
  </Demo>
</ComponentPage>
