---
import ComponentPage from "../../layouts/ComponentPage.astro";
import Demo from "../../components/Demo.astro";
import {
  ContributionGraphBasicDemo,
  ContributionGraphCustomLabelDemo,
  ContributionGraphLargerCellsDemo,
  ContributionGraphMondayStartDemo,
  ContributionGraphNoLabelsDemo,
} from "../../demos/ContributionGraphDemos";

// ContributionGraph is an interactive surface: each cell is a grid cell with a
// roving tabindex (arrow keys walk the grid) and hover/focus opens a Tooltip
// portaled to document.body. Both are client behaviour, so every demo is a
// self-contained React island (see src/demos/ContributionGraphDemos.tsx)
// rendered with `client:visible` — the "proven needed" exception to
// packages/site/CLAUDE.md § "No `client:*` unless proven needed". The sample
// data is generated inside those components rather than passed as props, so
// none of it is serialised into the page.

// The basic demo's code sample shows the exact data shape callers pass —
// one { date, count } per day, sorted ascending, contiguous. The middle
// elided so the snippet stays scannable without hiding the format.
const basic = `const data = [
  { date: "2025-01-01", count: 0 },
  { date: "2025-01-02", count: 3 },
  { date: "2025-01-03", count: 7 },
  // ...one entry per day, sorted ascending, contiguous...
  { date: "2025-12-30", count: 5 },
  { date: "2025-12-31", count: 12 },
];

<ContributionGraph data={data} />`;

const mondayStart = `<ContributionGraph data={data} weekStartsOn="monday" />`;

const larger = `<ContributionGraph
  data={data}
  cellSize={16}
  cellGap={4}
  cellRadius={3}
/>`;

const noLabels = `<ContributionGraph
  data={data}
  showMonthLabels={false}
  showWeekdayLabels={false}
  showLegend={false}
/>`;

const customLabel = `<ContributionGraph
  data={data}
  labelForDay={(day) =>
    day.count > 0
      ? \`\${day.date} → \${day.count} commit\${day.count === 1 ? "" : "s"}\`
      : \`\${day.date} → no activity\`
  }
/>`;
---

<ComponentPage slug="contribution-graph">
  <Demo title="Basic" code={basic}>
    <ContributionGraphBasicDemo client:visible />
  </Demo>

  <Demo title="Monday start" code={mondayStart}>
    <ContributionGraphMondayStartDemo client:visible />
  </Demo>

  <Demo title="Larger cells" code={larger}>
    <ContributionGraphLargerCellsDemo client:visible />
  </Demo>

  <Demo title="Without labels or legend" code={noLabels}>
    <ContributionGraphNoLabelsDemo client:visible />
  </Demo>

  <Demo title="Custom day label" code={customLabel}>
    <ContributionGraphCustomLabelDemo client:visible />
  </Demo>
</ComponentPage>
